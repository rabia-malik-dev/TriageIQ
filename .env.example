# Copy to .env and adjust values. Never commit .env.

ACCEPT_EULA=Y

SQLSERVER_SA_PASSWORD=TriageIQ_Local_Dev_1!
SQLSERVER_PORT=1433

SERVICEBUS_SQL_PASSWORD=TriageIQ_Bus_Dev_1!

API_PORT=8080

# Azure Service Bus emulator (M2+). UseDevelopmentEmulator=true for local Docker.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=local-dev-not-a-real-secret;UseDevelopmentEmulator=true;

# LLM (used from M3 onward)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# JWT (used from M1 onward)
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-in-local-dev

# Optional dev-only bootstrap admin (Development environment only)
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123!